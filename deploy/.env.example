# =============================================================================
# .env — one per environment: your dev machine, the staging server, production.
#
# deploy/setup creates and fills this file. Docker Compose reads it to fill in the
# rendered compose files, and bin/render reads it to render the templates.
# Nothing ever `source`s it, so values may contain spaces. Wrap a value in single
# quotes if it contains `$`, or Compose will try to interpolate it.
#
#   [setup]      written by deploy/setup or bin/render. Leave these alone.
#   [immutable]  never change once the store is installed.
#   [dev] / [server]  only read in that mode.
# =============================================================================

# ---- Stack -------------------------------------------------------------------
# Lowercase letters and digits, with single hyphens between them, starting with a
# letter, at most 41 characters. Every service, container and hostname is named
# <PROJECT_NAME>-<service>: shop-app, shop-mariadb, ... No underscores: they aren't
# valid in a hostname, and OpenSearch's TLS rejects them.
PROJECT_NAME=shop
# dev | staging | production
STACK_ENV=dev
# The Magento root: relative to this file's directory, or absolute.
MAGENTO_ROOT=src
# [setup] Absolute path of the deploy/ directory the templates are rendered from.
DEPLOY_DIR=
# [setup] Derived by bin/render from PROJECT_NAME, STACK_ENV and ACTIVE_COLOR.
COMPOSE_PROJECT_NAME=
COMPOSE_FILE=
COMPOSE_PROFILES=
# [dev] Optional dev services to run, comma separated. search-ui = OpenSearch Dashboards.
# Set it to `none` to run none and save the memory Dashboards uses. An empty value
# means the default.
DEV_PROFILES=search-ui
# Per-container log limits (Docker json-file driver).
LOG_MAX_SIZE=10m
LOG_MAX_FILE=5

# ---- Domains and ports -------------------------------------------------------
STORE_DOMAIN=shop.example.test
# [server] Extra hostnames, space separated, that redirect to STORE_DOMAIN (e.g. www.example.com).
STORE_ALIASES=
# [server] Let's Encrypt account email.
ACME_EMAIL=
# Dev binds to 127.0.0.1, so neither the store nor the tools are reachable from the network.
BIND_ADDRESS=127.0.0.1
HTTP_PORT=80
HTTPS_PORT=443
# Optional. Written into env.php so an imported database works without editing it.
# Include the port when HTTPS_PORT isn't 443, e.g. https://shop.example.test:9443/
MAGENTO_BASE_URL=

# ---- Magento -----------------------------------------------------------------
MAGE_MODE=developer
# Letters, digits and underscores. Varnish's VCL is rendered with it.
ADMIN_FRONT_NAME=admin
# The admin user's email, needed for a new install. "Forgot your password?" on the admin
# login sends the reset link there; in dev the mail lands in Mailpit.
ADMIN_EMAIL=
# [immutable] Copy these from the existing env.php when migrating. While CRYPT_KEY or
# INSTALL_DATE is empty, the stack treats Magento as not installed yet: no env.php is
# written, and cron and consumers wait.
CRYPT_KEY=
INSTALL_DATE=
GRAPHQL_ID_SALT=
CACHE_ID_PREFIX=
# Cache types. Core types are always managed; list a module's own types here (e.g.
# elasticsuite,compiled_plugins). The state is immutable: bin/magento cache:enable and
# cache:disable only last until the next container start. Change it here instead.
MAGENTO_CACHE_TYPES_EXTRA=
MAGENTO_CACHE_DISABLED=
# Cache ids each worker loads once and keeps in memory for its whole life. List only ids
# that change at deploy: a worker would keep serving any other id stale until it restarts.
MAGENTO_PRELOAD_KEYS=GLOBAL_PLUGIN_LIST,DB_IS_UP_TO_DATE
# varnish | builtin
FPC_BACKEND=varnish
# Comma-separated queue consumers for the consumers service. `bin/consumers list`
# compares this list with what the installed modules provide.
MAGENTO_CONSUMERS=async.operations.all,product_action_attribute.update,inventory.reservations.updateSalabilityStatus,mageosSeoFeedRegenerate
CONSUMER_MAX_MESSAGES=1000
# Space-separated cron groups, each run in its own loop.
CRON_GROUPS=default index
# disabled | file
DB_QUERY_LOG=disabled

# ---- PHP / FrankenPHP --------------------------------------------------------
# 8.3, 8.4 or 8.5: picks the published images (sental90/mageos-frankenphp-docker) the dev
# and prod images are built on. Changing it needs no Dockerfile edit; rebuild with bin/build.
PHP_VERSION=8.5
# Requests a worker handles before it restarts. 0 = unlimited.
MAX_REQUESTS=0
# [setup] FrankenPHP threads for each worker. Each thread boots its own Magento, so
# these set both the first-start time and the app's memory. setup writes them for each
# mode: dev 4/4/2, servers 8/4/2 (provisional until measured in prod mode).
#   WEB     pages, through pub/index.php
#   STATIC  /static files not yet on disk, through pub/static.php. In developer mode
#           every asset passes through it once (a Luma checkout loads 450-500);
#           deployed files never do.
#   MEDIA   resized images not yet on disk, through pub/get.php
# On a server they must fit APP_MEM_LIMIT: opcache (opcache.memory_consumption) plus
# all the threads times the memory each settles at, which is near the heaviest
# request it has served.
FRANKENPHP_WEB_WORKERS=
FRANKENPHP_STATIC_WORKERS=
FRANKENPHP_MEDIA_WORKERS=
# [dev] 1 restarts the workers whenever code under app/code or app/etc changes.
FRANKENPHP_WATCH=1
# [dev] off | debug | develop | profile | trace (comma-separate to combine). bin/xdebug switches it.
XDEBUG_MODE=off
# [setup][dev] www-data in the dev image takes this UID and GID, so files written into the code are yours.
HOST_UID=
HOST_GID=
# [setup][dev] The dev image's tag, dev-<UTC datetime>. setup and bin/build write it on
# each build, and remove older dev tags except the one they replaced.
DEV_IMAGE_TAG=

# ---- Build (the prod image) --------------------------------------------------
# Space separated, relative to MAGENTO_ROOT: directories whose package.json builds a theme's CSS.
THEME_PATHS=
LOCALES=en_US
SCD_JOBS=1
# Values for deploy/hooks/*.sh: space-separated KEY=VALUE pairs.
HOOK_ENV=

# ---- Database ----------------------------------------------------------------
DB_NAME=magento
DB_USER=magento
DB_PASSWORD=
DB_ROOT_PASSWORD=
# Optional host path for the data directory. Empty = a named Docker volume.
MARIADB_DATA=
MARIADB_BUFFER_POOL=1G

# ---- RabbitMQ ----------------------------------------------------------------
RABBITMQ_USER=magento
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=/

# ---- Valkey ------------------------------------------------------------------
VALKEY_SESSION_MEMORY=256mb
# On a server, blue and green each hold their own cache namespace during a release.
VALKEY_CACHE_MEMORY=512mb

# ---- OpenSearch --------------------------------------------------------------
# OpenSearch's policy: at least 8 characters, with upper, lower, digit and symbol.
# Use symbols from -_.@%+= only: the health check puts the admin password inside
# double quotes, so a quote, $, backtick or backslash would break it.
OPENSEARCH_ADMIN_PASSWORD=
OPENSEARCH_MAGENTO_USER=magento
OPENSEARCH_MAGENTO_PASSWORD=
OPENSEARCH_DASHBOARDS_PASSWORD=
# The index prefix. Written into env.php for both ElasticSuite and core search, and
# used as the index pattern the magento role may manage.
OPENSEARCH_INDEX_PREFIX=magento2
OPENSEARCH_HEAP=1g

# ---- Mail (server) -----------------------------------------------------------
# Dev ignores these: the dev overlay always points Magento at Mailpit.
# Leave SMTP_HOST empty to keep whatever the database says.
SMTP_HOST=
SMTP_PORT=587
# none | plain | login
SMTP_AUTH=login
# none | ssl | tls
SMTP_SSL=tls
SMTP_USER=
SMTP_PASSWORD=

# ---- Varnish -----------------------------------------------------------------
VARNISH_SIZE=256m
# [dev] 1 sends the store straight to the app, bypassing Varnish. bin/varnish switches it.
VARNISH_BYPASS=0

# ---- Server ------------------------------------------------------------------
DATA_DIR=/opt/shop/data
# [setup] Blue/green state, kept by bin/release.
ACTIVE_COLOR=blue
APP_IMAGE_BLUE=
APP_IMAGE_GREEN=
APP_IMAGE_ACTIVE=
# Memory caps. APP_MEM_LIMIT is per app colour, and both colours run during a release.
# setup server adds them all up and warns, without stopping, when the host has less RAM.
# CRON and CONSUMERS are provisional until measured in prod mode.
APP_MEM_LIMIT=3g
CRON_MEM_LIMIT=2g
CONSUMERS_MEM_LIMIT=2g
MARIADB_MEM_LIMIT=2g
OPENSEARCH_MEM_LIMIT=2g

# ---- Image tags --------------------------------------------------------------
# The defaults are exact versions in deploy/templates/compose*.tpl, which Renovate keeps
# current (deploy/README.md, Staging and production images). Set one here only to hold a
# service on another version; it then no longer follows Renovate's updates. OpenSearch and
# Dashboards must stay on the same version.
# CADDY_TAG=
# VARNISH_TAG=
# MARIADB_TAG=
# VALKEY_TAG=
# RABBITMQ_TAG=
# OPENSEARCH_TAG=
# DASHBOARDS_TAG=
# DOZZLE_TAG=
# MAILPIT_TAG=
# PHPMYADMIN_TAG=
