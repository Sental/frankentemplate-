# =============================================================================
# FrankenPHP's embedded Caddyfile: serves Magento on :80 inside the app container.
# TLS ends at the edge Caddy; Varnish sits between the edge and this server.
#
# Three workers, each a long-lived PHP process booted once:
#   static-worker  /static/* that isn't on disk yet, through pub/static.php
#   media-worker   /media/* that isn't on disk (resized images), through pub/get.php
#   web-worker     everything else, through pub/index.php
# pub/index.php, static.php and get.php are opengento's worker entry points,
# installed by opengento/magento2-frankenphp-base.
#
# Each worker block ends with the FRANKENPHP_WORKER_EXTRA placeholder. It's empty
# unless FRANKENPHP_WATCH=1 (dev); the entrypoint then fills it with
# `watch <glob>` lines, so workers restart when code changes.
#
# Never write a Caddy environment placeholder (dollar sign inside braces) in a
# comment in this file. Caddy substitutes them before it parses anything,
# comments included. A multi-line value written in a comment turns its later
# lines into config, and that's exactly how this file once failed with
# "Unexpected '{' on a new line".
#
# If FrankenPHP exits with no message straight after "using config from file",
# the cause is a parse error in this file. `frankenphp run` doesn't print parse
# errors; `frankenphp adapt --config /etc/frankenphp/Caddyfile` does.
#
# Formatted with `caddy fmt` (tabs).
# =============================================================================
{
	admin off

	frankenphp {
		worker {
			file /app/pub/static.php
			name static-worker
			{$FRANKENPHP_WORKER_EXTRA}
		}

		worker {
			file /app/pub/get.php
			name media-worker
			{$FRANKENPHP_WORKER_EXTRA}
		}

		worker {
			file /app/pub/index.php
			name web-worker
			{$FRANKENPHP_WORKER_EXTRA}
		}
	}

	order php_server before file_server
}

(404) {
	rewrite * /errors/404.php
	php_server
	file_server
}

:80 {
	root * /app/pub
	encode zstd br gzip

	# -------------------------------------------------------------------------
	# PHP-generated routes that must pass before the sensitive-file block
	# -------------------------------------------------------------------------
	handle /llms.txt {
		php_server
	}
	handle /llms-full.txt {
		php_server
	}
	handle /llms.jsonl {
		php_server
	}
	handle /robots.txt {
		php_server
	}
	handle /.well-known/* {
		php_server
	}

	# -------------------------------------------------------------------------
	# Sensitive files and directories: answer 404 before any PHP runs
	# -------------------------------------------------------------------------
	@sensitiveFiles {
		path_regexp sensitiveFiles /(\.user.ini|\.php$|.*\.phtml$|\.htaccess$|\.htpasswd$|\.git|.*\.txt|.*\.md|errors\/.*\.xml|media\/theme_customization\/.*\.xml)
	}
	@sensitiveDirectories {
		path_regexp sensitiveDirectories /(media\/customer\/*|media\/downloadable\/*|media\/import\/*|media\/custom_options\/*|setup\/*)
	}
	handle @sensitiveFiles {
		import 404
	}
	handle @sensitiveDirectories {
		import 404
	}

	# -------------------------------------------------------------------------
	# Response headers
	# -------------------------------------------------------------------------
	header {
		# Client hints for dark mode and responsive images
		+Accept-CH "Sec-CH-Prefers-Color-Scheme, DPR, Viewport-Width, Width, Sec-CH-UA-Mobile"
		+Critical-CH "Sec-CH-Prefers-Color-Scheme"
		Vary "Sec-CH-Prefers-Color-Scheme"

		# Lets browsers reuse a prefetch across tracking parameters. RFC 8941 syntax:
		# double quotes and space separators, or browsers ignore it.
		+No-Vary-Search `key-order, params=("utm_source" "utm_medium" "utm_campaign" "utm_term" "utm_content" "gclid" "fbclid" "msclkid" "srsltid")`
	}

	header /media X-Frame-Options "SAMEORIGIN"
	header /static X-Frame-Options "SAMEORIGIN"
	header / X-Content-Type-Options "nosniff"

	# -------------------------------------------------------------------------
	# Static files: strip the /static/versionNNN/ segment Magento adds, serve the
	# file if it exists, otherwise generate it through static.php
	# -------------------------------------------------------------------------
	@staticPath path_regexp reg_static ^/static/(version\d*/)?(.*)$
	handle @staticPath {
		@static file /static/{re.reg_static.2}
		rewrite @static /static/{re.reg_static.2}

		@staticFiles {
			path *.ico *.jpg *.jpeg *.png *.gif *.svg *.svgz *.webp *.avif *.avifs *.js *.css *.eot *.ttf *.otf *.woff *.woff2 *.html *.json *.webmanifest
		}
		handle @staticFiles {
			header Cache-Control "public, max-age=31536000"
		}
		@noCacheFiles {
			path *.zip *.gz *.gzip *.bz2 *.csv *.xml
		}
		handle @noCacheFiles {
			header Cache-Control "no-store, no-cache, must-revalidate"
		}

		@dynamic not file /static/{re.reg_static.2}
		rewrite @dynamic /static.php?resource={re.reg_static.2}
		header X-Frame-Options "SAMEORIGIN"

		php_server
		file_server
	}

	# -------------------------------------------------------------------------
	# Media files: serve if on disk, otherwise let get.php generate them
	# -------------------------------------------------------------------------
	route /media/* {
		@staticFiles {
			path *.ico *.jpg *.jpeg *.png *.gif *.svg *.svgz *.webp *.avif *.avifs *.js *.css *.eot *.ttf *.otf *.woff *.woff2
		}
		handle @staticFiles {
			header Cache-Control "public, max-age=31536000"
		}
		@noCacheFiles {
			path *.zip *.gz *.gzip *.bz2 *.csv *.xml
		}
		handle @noCacheFiles {
			header Cache-Control "no-store, no-cache, must-revalidate"
		}

		@dynamic not file {path}
		rewrite @dynamic /get.php{query}

		php_server
		file_server
	}

	# -------------------------------------------------------------------------
	# Everything else: the web worker
	# -------------------------------------------------------------------------
	handle_errors 404 403 {
		import 404
	}

	route {
		php_server
		file_server
	}
}
