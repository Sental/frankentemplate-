#!/usr/bin/env bash
# =============================================================================
# bin/secrets: an encrypted copy of each server's .env, kept in the repository.
#
#   bin/secrets init                 create this machine's age key (once), and add its
#                                    public key to deploy/secrets/recipients.txt
#   bin/secrets encrypt <env> [file] encrypt a .env (default: this root's .env) to
#                                    deploy/secrets/<env>.env, for every recipient
#   bin/secrets decrypt <env>        print deploy/secrets/<env>.env, decrypted
#   bin/secrets decrypt-file <file>  print any SOPS-encrypted .env, decrypted
#                                    (deploy/setup server --secrets uses this)
#
# Why: losing a server must never lose its CRYPT_KEY. Without that key, every encrypted
# config value in the database (payment credentials, API keys) is unreadable.
#
# How it works:
#   - SOPS encrypts each value and leaves the keys readable, so a diff shows which
#     setting changed without revealing it.
#   - age provides the keys. The private key stays at ~/.config/sops/age/keys.txt
#     (0600) on each machine allowed to decrypt. The public keys sit in
#     deploy/secrets/recipients.txt, which is safe to commit.
#   - Both tools run from containers, so nothing is installed on the host.
#   - SOPS publishes no major-version tag, so its image is pinned exactly. Override
#     it with SOPS_IMAGE.
#
# After adding a recipient, re-encrypt each environment so the new key can read it:
#   bin/secrets decrypt production > /tmp/p.env && bin/secrets encrypt production /tmp/p.env && rm /tmp/p.env
# =============================================================================
# shellcheck source=_lib.sh
. "$(dirname "$0")/_lib.sh"

SOPS_IMAGE=${SOPS_IMAGE:-ghcr.io/getsops/sops:v3.13.3-alpine}
KEY_FILE=${SOPS_AGE_KEY_FILE:-$HOME/.config/sops/age/keys.txt}
SECRETS_DIR="$DEPLOY_DIR/secrets"
RECIPIENTS="$SECRETS_DIR/recipients.txt"

usage() {
    cat >&2 <<'USAGE'
Usage:
  bin/secrets init
  bin/secrets encrypt <env> [file]
  bin/secrets decrypt <env>
  bin/secrets decrypt-file <file>
USAGE
    exit 1
}

valid_env() {
    [[ "$1" =~ ^[a-z][a-z0-9_-]*$ ]] || die "the environment name must be lowercase (e.g. staging, production), not '$1'"
}

sops() {
    docker run --rm -i -u "$(id -u):$(id -g)" --entrypoint sops "$@"
}

cmd_init() {
    local public
    mkdir -p "$(dirname "$KEY_FILE")" "$SECRETS_DIR"
    if [ -f "$KEY_FILE" ]; then
        info "an age key already exists at $KEY_FILE; keeping it"
    else
        # age-keygen in a throwaway Alpine container. The key reaches the host only
        # through this pipe, into a file created 0600.
        ( umask 077; docker run --rm alpine:3 sh -c 'apk add --no-cache -q age >/dev/null && age-keygen 2>/dev/null' > "$KEY_FILE" )
        info "created $KEY_FILE. Back it up somewhere safe: without it, nothing encrypted to it can be decrypted."
    fi
    public=$(grep -m1 '^# public key: ' "$KEY_FILE" | sed 's/^# public key: //')
    [ -n "$public" ] || die "no public key line in $KEY_FILE"
    touch "$RECIPIENTS"
    if grep -qxF "$public" "$RECIPIENTS"; then
        info "$public is already a recipient"
    else
        printf '%s\n' "$public" >> "$RECIPIENTS"
        info "added $public to deploy/secrets/recipients.txt (commit it, then re-encrypt existing files)"
    fi
}

cmd_encrypt() {
    local env=${1:-} src=${2:-$ENV_FILE} recipients out
    [ -n "$env" ] || usage
    valid_env "$env"
    [ -f "$src" ] || die "no such file: $src"
    [ -s "$RECIPIENTS" ] || die "deploy/secrets/recipients.txt is empty: run bin/secrets init first"
    recipients=$(grep -vE '^[[:space:]]*(#|$)' "$RECIPIENTS" | paste -sd, -)
    out="$SECRETS_DIR/$env.env"
    sops -v "$(readlink -f "$src"):/in.env:ro" "$SOPS_IMAGE" \
        --encrypt --input-type dotenv --output-type dotenv --age "$recipients" /in.env > "$out.tmp.$$"
    mv "$out.tmp.$$" "$out"
    info "encrypted $src -> deploy/secrets/$env.env (safe to commit)"
}

decrypt_file() {
    local file=$1
    [ -f "$file" ] || die "no such file: $file"
    [ -f "$KEY_FILE" ] || die "no age key at $KEY_FILE, so this machine can't decrypt. Copy the key here (0600), or set SOPS_AGE_KEY_FILE."
    sops -e SOPS_AGE_KEY_FILE=/keys.txt -v "$KEY_FILE:/keys.txt:ro" -v "$(readlink -f "$file"):/in.env:ro" "$SOPS_IMAGE" \
        --decrypt --input-type dotenv --output-type dotenv /in.env
}

case "${1:-}" in
    init)          cmd_init ;;
    encrypt)       shift; cmd_encrypt "$@" ;;
    decrypt)       [ -n "${2:-}" ] || usage; valid_env "$2"; decrypt_file "$SECRETS_DIR/$2.env" ;;
    decrypt-file)  [ -n "${2:-}" ] || usage; decrypt_file "$2" ;;
    *)             usage ;;
esac
