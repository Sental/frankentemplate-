#!/usr/bin/env bash
# =============================================================================
# bin/render: renders deploy/templates into the files Compose, Caddy, Varnish and
# OpenSearch read, using the values in .env.
#
#   <root>/compose.yaml                         base services
#   <root>/compose.dev.yaml or compose.server.yaml   the overlay for STACK_ENV
#   <root>/.stack/caddy/Caddyfile               dev or server edge
#   <root>/.stack/varnish/default.vcl           the VCL, aimed at the active app
#   <root>/.stack/opensearch/security/*.yml     users, roles and mappings
#   <root>/.stack/opensearch/opensearch_dashboards.yml   (dev)
#
# It also sets COMPOSE_PROJECT_NAME, COMPOSE_FILE, COMPOSE_PROFILES and DEPLOY_DIR
# in .env. It's safe to run at any time; bin/start, bin/varnish and bin/release all
# run it. Anything left unrendered stops it with the template and token named.
#
# Templates use {{TOKEN}}. Everything else, ${VAR} for Compose and {$VAR} for Caddy,
# passes through untouched.
# =============================================================================
# shellcheck source=_lib.sh
. "$(dirname "$0")/_lib.sh"

usage() {
    cat >&2 <<'USAGE'
Usage: bin/render

Renders deploy/templates using .env. No arguments.
USAGE
    exit 1
}
[ $# -eq 0 ] || usage

declare -A TOKENS=()

# render_file TEMPLATE OUTPUT [MODE]: substitutes every {{TOKEN}}, then replaces OUTPUT
# by renaming a temp file into place, so a reader never sees half a file.
render_file() {
    local template=$1 output=$2 mode=${3:-0644} content name leftover tmp
    content=$(<"$DEPLOY_DIR/templates/$template")
    TOKENS[GENERATED_HEADER]="GENERATED by bin/render from deploy/templates/$template. Don't edit it: edit the template, then run bin/render."
    for name in "${!TOKENS[@]}"; do
        # The pattern and the replacement are both quoted, so both are literal
        # (an `&` in a value stays an `&`).
        content=${content//"{{$name}}"/"${TOKENS[$name]}"}
    done
    leftover=$(grep -oE '\{\{[A-Z_]+\}\}' <<< "$content" | sort -u | tr '\n' ' ' || true)
    [ -z "$leftover" ] || die "deploy/templates/$template: no value for ${leftover% }"
    mkdir -p "$(dirname "$output")"
    tmp="$output.tmp.$$"
    printf '%s\n' "$content" > "$tmp"
    chmod "$mode" "$tmp"
    mv "$tmp" "$output"
}

# Single-quoted YAML scalar: a ' inside is written as ''.
yaml_quote() {
    local value=${1//\'/\'\'}
    printf "'%s'" "$value"
}

main() {
    local project env color admin overlay other varnish_backend
    local root stack_dir hashes cf_ips aliases profiles

    project=$(project)
    env=$(stack_env)
    case "$env" in
        dev|staging|production) ;;
        *) die "STACK_ENV must be dev, staging or production (got '$env')" ;;
    esac
    color=$(env_get ACTIVE_COLOR blue)
    case "$color" in
        blue|green) ;;
        *) die "ACTIVE_COLOR must be blue or green (got '$color')" ;;
    esac
    admin=$(env_get ADMIN_FRONT_NAME admin)
    [[ "$admin" =~ ^[A-Za-z0-9_]+$ ]] \
        || die "ADMIN_FRONT_NAME may contain only letters, digits and underscores, because it goes into the VCL as a regex (got '$admin')"

    root=$(magento_root)
    stack_dir="$STACK_ROOT/.stack"
    # Created here, as the user. If Compose's bind mount created it instead, it would be
    # root's, and deploy/setup couldn't write the certificates into it.
    mkdir -p "$stack_dir/opensearch/certs"

    if [ "$env" = "dev" ]; then
        overlay=compose.dev.yaml
        other=compose.server.yaml
        varnish_backend="${project}-app"
        profiles=$(env_get DEV_PROFILES search-ui)
        if [ "$(env_get VARNISH_BYPASS 0)" = "1" ]; then
            TOKENS[STORE_UPSTREAM]="${project}-app:80"
        else
            TOKENS[STORE_UPSTREAM]="${project}-varnish:80"
        fi
        # The search. site: Dashboards when its profile is on, otherwise a page that
        # says it's off and how to turn it on, instead of a bare 502.
        if dev_profile_on search-ui; then
            TOKENS[SEARCH_UI_HANDLER]="reverse_proxy ${project}-opensearch-dashboards:5601
	handle_errors 502 {
		respond \"OpenSearch Dashboards isn't answering. It starts a minute or so after OpenSearch is healthy: see bin/status and bin/log opensearch-dashboards.\" 502
	}"
        else
            TOKENS[SEARCH_UI_HANDLER]="respond \"OpenSearch Dashboards is off: DEV_PROFILES in .env doesn't include search-ui. Add it, then run bin/start.\" 503"
        fi
    else
        overlay=compose.server.yaml
        other=compose.dev.yaml
        varnish_backend="${project}-app-${color}"
        profiles=$color
    fi

    TOKENS[PROJECT]=$project
    TOKENS[DEPLOY_DIR]=$DEPLOY_DIR
    TOKENS[STACK_DIR]=$stack_dir
    TOKENS[MAGENTO_ROOT]=$root
    TOKENS[ACTIVE_COLOR]=$color
    TOKENS[ADMIN_FRONT_NAME]=$admin
    TOKENS[VARNISH_BACKEND]=$varnish_backend
    TOKENS[OPENSEARCH_MAGENTO_USER]=$(env_get OPENSEARCH_MAGENTO_USER magento)
    TOKENS[OPENSEARCH_INDEX_PREFIX]=$(env_get OPENSEARCH_INDEX_PREFIX magento2)

    # Cloudflare's ranges, one line, for trusted_proxies.
    cf_ips=$(grep -vE '^[[:space:]]*(#|$)' "$DEPLOY_DIR/config/caddy/cloudflare-ips.txt" | tr '\n' ' ')
    TOKENS[CLOUDFLARE_TRUSTED_PROXIES]=${cf_ips% }

    # One redirect site for every STORE_ALIASES name.
    aliases=$(env_get STORE_ALIASES)
    if [ -n "$aliases" ]; then
        # shellcheck disable=SC2001 # a plain sed is clearer here than parameter expansion
        TOKENS[STORE_ALIASES_SITE]="$(sed 's/[[:space:]]\{1,\}/, /g' <<< "$aliases") {
	import refuse_cache_methods
	redir https://{\$STORE_DOMAIN}{uri} permanent
}"
    else
        TOKENS[STORE_ALIASES_SITE]=""
    fi

    # Compose wiring, derived here so it always matches the mode.
    env_set COMPOSE_PROJECT_NAME "$project"
    env_set COMPOSE_FILE "compose.yaml:$overlay"
    env_set COMPOSE_PROFILES "$profiles"
    env_set DEPLOY_DIR "$DEPLOY_DIR"

    render_file compose.yaml.tpl "$STACK_ROOT/compose.yaml"
    render_file "$overlay.tpl" "$STACK_ROOT/$overlay"
    # An overlay from the other mode would be stale; nothing must read it.
    rm -f "$STACK_ROOT/$other"

    if [ "$env" = "dev" ]; then
        render_file caddy/Caddyfile.dev.tpl "$stack_dir/caddy/Caddyfile"
    else
        render_file caddy/Caddyfile.server.tpl "$stack_dir/caddy/Caddyfile"
    fi
    render_file varnish/default.vcl.tpl "$stack_dir/varnish/default.vcl"
    render_file opensearch/roles.yml.tpl "$stack_dir/opensearch/security/roles.yml"
    render_file opensearch/roles_mapping.yml.tpl "$stack_dir/opensearch/security/roles_mapping.yml"

    # Password hashes come from deploy/setup, which runs OpenSearch's own hash tool.
    # Without them there are no users: say so, and leave the file missing. Compose then
    # refuses to start OpenSearch (create_host_path: false) instead of starting it with
    # a broken user list.
    hashes="$stack_dir/opensearch/hashes.env"
    if [ -f "$hashes" ]; then
        TOKENS[OPENSEARCH_ADMIN_HASH]=$(dotenv_get "$hashes" OPENSEARCH_ADMIN_HASH)
        TOKENS[OPENSEARCH_DASHBOARDS_HASH]=$(dotenv_get "$hashes" OPENSEARCH_DASHBOARDS_HASH)
        TOKENS[OPENSEARCH_MAGENTO_HASH]=$(dotenv_get "$hashes" OPENSEARCH_MAGENTO_HASH)
        local token
        for token in OPENSEARCH_ADMIN_HASH OPENSEARCH_DASHBOARDS_HASH OPENSEARCH_MAGENTO_HASH; do
            [ -n "${TOKENS[$token]}" ] || die "$hashes has no $token: rerun deploy/setup to regenerate the OpenSearch hashes"
        done
        render_file opensearch/internal_users.yml.tpl "$stack_dir/opensearch/security/internal_users.yml"
    else
        warn "no OpenSearch password hashes yet ($hashes): deploy/setup creates them. OpenSearch won't start until then."
    fi

    if [ "$env" = "dev" ]; then
        TOKENS[OPENSEARCH_DASHBOARDS_PASSWORD_YAML]=$(yaml_quote "$(env_get OPENSEARCH_DASHBOARDS_PASSWORD)")
        # 0600: it holds the Dashboards password. Dashboards runs as uid 1000, which is
        # the dev user's own uid on a single-user dev machine.
        render_file opensearch/opensearch_dashboards.yml.tpl "$stack_dir/opensearch/opensearch_dashboards.yml" 0600
    fi

    info "rendered for $env (project $project, varnish -> $varnish_backend)"
}

main "$@"
